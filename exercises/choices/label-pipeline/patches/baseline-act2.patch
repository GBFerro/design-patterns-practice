 import type { Shipment } from "./types.ts";
 
+const SIGNATURE_WEIGHT_THRESHOLD_KG = 20;
+
 export function buildLabel(shipment: Shipment): string {
+  const isDomestic = shipment.destinationCountry === "US";
+  const requiresSignature = shipment.weightKg > SIGNATURE_WEIGHT_THRESHOLD_KG;
+
   const lines: string[] = [];
