 import type { OrderObserver } from "./observers.ts";
 import type { Order } from "./types.ts";
 
-/** Every consumer is an equal, independent subscriber - none knows the others exist. */
+/**
+ * Two lists instead of one: act 2 needs to tell "always runs" observers apart from
+ * "skippable on a hold" ones, which a single flat list of equal peers had no way to express.
+ */
 export class OrderShippedSubject {
-  private readonly observers: OrderObserver[] = [];
+  private readonly always: OrderObserver[] = [];
+  private readonly conditional: OrderObserver[] = [];
 
-  subscribe(observer: OrderObserver): void {
-    this.observers.push(observer);
+  subscribeAlways(observer: OrderObserver): void {
+    this.always.push(observer);
   }
 
-  notifyAll(order: Order): void {
-    for (const observer of this.observers) {
+  subscribeConditional(observer: OrderObserver): void {
+    this.conditional.push(observer);
+  }
+
+  notifyAll(order: Order, held: boolean): void {
+    for (const observer of this.always) {
       observer.notify(order);
     }
+    if (!held) {
+      for (const observer of this.conditional) {
+        observer.notify(order);
+      }
+    }
   }
 }
