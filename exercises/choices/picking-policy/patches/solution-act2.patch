diff --git a/after/solutions/state/states/surge-state.ts b/solutions/state/states/surge-state.ts
new file mode 100644
index 0000000..50fbe91
--- /dev/null
+++ b/solutions/state/states/surge-state.ts
@@ -0,0 +1,36 @@
+import type { Order } from "../types.ts";
+import { BatchState } from "./batch-state.ts";
+import { IndividualState } from "./individual-state.ts";
+import { oldest, type PlanResult, type PolicyState } from "./policy-state.ts";
+
+export class SurgeState implements PolicyState {
+  readonly name = "surge" as const;
+
+  constructor(
+    private readonly surgeOrderIds: Set<string>,
+    private readonly suspendedBatchIds: Set<string>,
+  ) {}
+
+  plan(queue: readonly Order[]): PlanResult {
+    const surviving = queue.filter((order) => this.surgeOrderIds.has(order.id));
+    const target = oldest(surviving);
+    const matching = surviving.filter((order) => order.binId === target.binId);
+    return {
+      instruction: {
+        mode: "batch",
+        binId: target.binId,
+        orderIds: matching.map((order) => order.id),
+        urgent: true,
+      },
+      next: this,
+    };
+  }
+
+  recordPicked(orderId: string): PolicyState {
+    this.surgeOrderIds.delete(orderId);
+    if (this.surgeOrderIds.size > 0) return this;
+    return this.suspendedBatchIds.size > 0
+      ? new BatchState(this.suspendedBatchIds)
+      : new IndividualState();
+  }
+}
