--- /dev/null
+++ b/src/rate-cache.ts
@@ -0,0 +1,31 @@
+import type { CarrierId, CarrierRate } from "./types.ts";
+
+const cache = new Map<string, CarrierRate>();
+
+function key(
+  carrierId: CarrierId,
+  originZip: string,
+  destZip: string,
+  weightKg: number,
+): string {
+  return `${carrierId}|${originZip}|${destZip}|${weightKg}`;
+}
+
+export function cachedRate(
+  carrierId: CarrierId,
+  originZip: string,
+  destZip: string,
+  weightKg: number,
+): CarrierRate | undefined {
+  return cache.get(key(carrierId, originZip, destZip, weightKg));
+}
+
+export function storeRate(
+  carrierId: CarrierId,
+  originZip: string,
+  destZip: string,
+  weightKg: number,
+  rate: CarrierRate,
+): void {
+  cache.set(key(carrierId, originZip, destZip, weightKg), rate);
+}
