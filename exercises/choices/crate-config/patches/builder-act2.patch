--- a/solutions/builder/crate-spec.ts
+++ b/solutions/builder/crate-spec.ts
@@ -6,11 +6,13 @@ export function buildExportCrate(
   widthCm: number,
   heightCm: number,
   maxLoadKg: number,
+  insulated = false,
 ): CrateSpec {
