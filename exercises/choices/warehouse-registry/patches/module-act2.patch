+
+/**
+ * Everything the app can do with one bin registry - a second, independent
+ * implementation of the four functions above. `registerBin` and friends only
+ * know how to read the one shared module-level `bins` above, so there is no
+ * way to point them at a different array.
+ */
+export interface WarehouseRegistryHandle {
+  registerBin(bin: BinLocation): void;
+  binLocation(binId: string): BinLocation | undefined;
+  binsInAisle(aisle: string): readonly BinLocation[];
+  clear(): void;
+}
+
+/**
+ * Builds one independent bin registry - the only way to get a registry that
+ * is not the one shared module-level array every other function here reads
+ * from.
+ */
+export function createWarehouseRegistry(): WarehouseRegistryHandle {
+  let ownBins: BinLocation[] = [];
+  return {
+    registerBin(bin) {
+      ownBins.push(bin);
+    },
+    binLocation(binId) {
+      return ownBins.find((bin) => bin.binId === binId);
+    },
+    binsInAisle(aisle) {
+      return ownBins.filter((bin) => bin.aisle === aisle);
+    },
+    clear() {
+      ownBins = [];
+    },
+  };
+}
