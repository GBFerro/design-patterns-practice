+export class HazmatSurcharge implements Surcharge {
+  readonly id = "hazmat";
+  private static readonly CENTS = 3000;
+
+  // No strategy can see another strategy's result, so this one re-derives both conditions
+  // from the shipment itself instead of reading remoteArea/oversize's computed amounts.
+  compute(shipment: Shipment): number {
+    return shipment.destination === "remote" && isOversize(shipment) ? HazmatSurcharge.CENTS : 0;
+  }
+}
+
 export const SURCHARGES: readonly Surcharge[] = [
   new FuelSurcharge(),
   new RemoteAreaSurcharge(),
   new OversizeSurcharge(),
+  new HazmatSurcharge(),
 ];
