diff --git a/src/feeder.ts b/src/feeder.ts
index 8c48d0a..9dd0abd 100644
--- a/src/feeder.ts
+++ b/src/feeder.ts
@@ -14,11 +14,20 @@ class OffsetFeeder implements Feeder {
   }
 }
 
+class WideFormatFeeder implements Feeder {
+  readonly family = "wide-format" as const;
+  describe(): string {
+    return "wide-format roll feeder";
+  }
+}
+
 export function createFeeder(family: PressFamily): Feeder {
   switch (family) {
     case "digital":
       return new DigitalFeeder();
     case "offset":
       return new OffsetFeeder();
+    case "wide-format":
+      return new WideFormatFeeder();
   }
 }
