diff --git a/src/jobs/foil-stamping.ts b/src/jobs/foil-stamping.ts
new file mode 100644
index 0000000..91cb848
--- /dev/null
+++ b/src/jobs/foil-stamping.ts
@@ -0,0 +1,19 @@
+import type { PrintJob } from "../types.ts";
+
+export class FoilStampingJob implements PrintJob {
+  readonly jobKind = "foil-stamping" as const;
+
+  constructor(
+    readonly customerName: string,
+    readonly quantity: number,
+    readonly foilColor: "gold" | "silver" | "copper",
+  ) {}
+
+  describe(): string {
+    return `${this.quantity} foil-stamped pieces for ${this.customerName} (${this.foilColor} foil)`;
+  }
+
+  estimatedMinutes(): number {
+    return 20 + Math.ceil(this.quantity / 50);
+  }
+}
