+import type { RouteNode } from "./route-node.ts";
+
+/** Leaf: a walking transfer's only contribution is its own walking time -
+ *  nothing about Line, Journey, or the other leaves had to change for
+ *  this to be true. */
+export class WalkingTransfer implements RouteNode {
+  constructor(public readonly walkMinutes: number) {}
+
+  totalMinutes(): number {
+    return this.walkMinutes;
+  }
