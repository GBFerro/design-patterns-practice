+const RESTRICTED_VEHICLE_IDS = new Set(["svc-9"]);
+
+/** A virtual proxy that also guards access: caches each vehicle's position the first
+ *  time it's asked for, and refuses to ask the real service for a restricted one at
+ *  all. Every caller shares this one instance instead of talking to the real service
+ *  directly. */
 export class VehiclePositionProxy implements VehiclePositionService {
   private readonly cache = new Map<string, VehiclePosition>();
 
   constructor(private readonly realService: VehiclePositionService) {}
 
   currentPosition(vehicleId: string): VehiclePosition {
+    if (RESTRICTED_VEHICLE_IDS.has(vehicleId)) throw new Error(`access denied for vehicle: ${vehicleId}`);
+
     const cached = this.cache.get(vehicleId);
     if (cached) return cached;
 
