@@ -0,0 +1,17 @@
+import type { Route } from "./types.ts";
+
+const LINE_ALERTS: Record<string, string> = {
+  red: "Red Line: minor delays near Mill Ave",
+  green: "Green Line: reduced weekend service to Riverside",
+};
+
+/** Replaces AlertService: reads from the live feed instead of a static table. */
+export class RealTimeAlertService {
+  constructor(private readonly feedUrl: string) {}
+
+  activeAlerts(route: Route): string[] {
+    return route.legs
+      .map((leg) => LINE_ALERTS[leg.lineId])
+      .filter((alert): alert is string => alert !== undefined);
+  }
+}
