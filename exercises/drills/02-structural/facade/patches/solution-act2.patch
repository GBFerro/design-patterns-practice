diff --git a/solutions/facade/surcharge-service.ts b/solutions/facade/surcharge-service.ts
new file mode 100644
index 0000000..d9e9d0d
--- /dev/null
+++ b/solutions/facade/surcharge-service.ts
@@ -0,0 +1,12 @@
+import type { Route } from "./types.ts";
+
+const GREEN_LINE_ID = "green";
+const RIVERSIDE_SURCHARGE_CENTS = 50;
+
+/** New subsystem: a flat surcharge for trips that cross into Riverside. */
+export class SurchargeService {
+  peakSurchargeCents(route: Route): number {
+    const crossesIntoRiverside = route.legs.some((leg) => leg.lineId === GREEN_LINE_ID);
+    return crossesIntoRiverside ? RIVERSIDE_SURCHARGE_CENTS : 0;
+  }
+}
