index 0000000..b476122
--- /dev/null
+++ b/solutions/adapter/contactless-reader-adapter.ts
@@ -0,0 +1,18 @@
+import type { ContactlessReader, FareRead, FareReader } from "./types.ts";
+
+/** Makes the contactless pilot reader usable anywhere a FareReader is
+ *  expected - its raw "cardId,balanceCents" wire string becomes a
+ *  proper FareRead, and an unpolled reader becomes null instead of
+ *  undefined. */
+export class ContactlessReaderAdapter implements FareReader {
+  constructor(private readonly reader: ContactlessReader) {}
+
+  readFare(): FareRead | null {
+    const polled = this.reader.poll();
+    if (polled === undefined) {
+      return null;
+    }
+    const [cardId = "", balanceText] = polled.split(",");
+    return { cardId, balanceCents: Number(balanceText) };
+  }
+}
