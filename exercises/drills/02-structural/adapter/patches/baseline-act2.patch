+
+/** The same admission rule, written a third time, for the contactless
+ *  pilot reader - parsing its raw wire string right here, because
+ *  nothing else in this file knows how to. */
+export function admitContactlessPassenger(reader: ContactlessReader): AdmissionResult {
+  const polled = reader.poll();
+  if (polled === undefined) {
+    return { admitted: false, reason: "no card presented" };
+  }
+  const [, balanceText] = polled.split(",");
+  const balanceCents = Number(balanceText);
+  if (balanceCents < FARE_CENTS) {
+    return { admitted: false, reason: "insufficient balance" };
+  }
+  return { admitted: true, remainingBalanceCents: balanceCents - FARE_CENTS };
+}
