diff --git a/after/solutions/decorator/senior-discount.ts b/solutions/decorator/senior-discount.ts
new file mode 100644
index 0000000..ea9f1ec
--- /dev/null
+++ b/solutions/decorator/senior-discount.ts
@@ -0,0 +1,14 @@
+import type { Fare } from "./fare.ts";
+
+const SENIOR_DISCOUNT_CENTS = 50;
+
+/** Decorator: a flat discount off whatever fare it wraps - unlike the
+ *  percentage decorators, this one is not commutative with them, and
+ *  nothing in its type says so. */
+export class SeniorDiscount implements Fare {
+  constructor(private readonly inner: Fare) {}
+
+  priceCents(): number {
+    return this.inner.priceCents() - SENIOR_DISCOUNT_CENTS;
+  }
+}
