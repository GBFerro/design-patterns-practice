+import type { PanelMediator } from "../panel-mediator.ts";
+
+export class DomeStatus {
+  open = false;
+
+  constructor(private readonly mediator: PanelMediator) {}
+
+  setOpen(open: boolean): void {
+    this.open = open;
+    this.mediator.domeChanged(open);
+  }
