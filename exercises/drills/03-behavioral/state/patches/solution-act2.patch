+++ b/solutions/state/states/fault.ts
@@ -0,0 +1,32 @@
+import type { TelescopeState } from "../state.ts";
+import { parkedState } from "./parked.ts";
+
+/** Reached only through Controller#raiseFault, never through a normal
+ *  transition - which is why no other state needs to know this one exists. */
+export class FaultState implements TelescopeState {
+  readonly name = "fault";
+
+  constructor(private readonly reason: string) {}
+
+  park(): TelescopeState {
+    return parkedState;
+  }
+
+  slewTo(): TelescopeState {
+    throw new Error(
+      `Cannot slew: the telescope is in fault (${this.reason}). Park to recover.`,
+    );
+  }
+
+  arrive(): TelescopeState {
+    throw new Error(
+      `Cannot arrive: the telescope is in fault (${this.reason}). Park to recover.`,
+    );
+  }
+
+  nudge(): TelescopeState {
+    throw new Error(
+      `Cannot nudge: the telescope is in fault (${this.reason}). Park to recover.`,
+    );
+  }
+}
