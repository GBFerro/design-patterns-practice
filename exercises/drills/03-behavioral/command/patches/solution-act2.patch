new file mode 100644
index 0000000..ef0e6e6
--- /dev/null
+++ b/solutions/command/commands/macro.ts
@@ -0,0 +1,19 @@
+import type { Command } from "../command.ts";
+
+export class MacroCommand implements Command {
+  readonly description: string;
+
+  constructor(private readonly commands: readonly Command[]) {
+    this.description = `macro(${commands.map((command) => command.description).join(", ")})`;
+  }
+
+  execute(): void {
+    for (const command of this.commands) command.execute();
+  }
+
+  undo(): void {
+    for (let index = this.commands.length - 1; index >= 0; index -= 1) {
+      this.commands[index]!.undo();
+    }
+  }
+}
