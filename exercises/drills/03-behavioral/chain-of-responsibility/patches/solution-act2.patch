--- /dev/null
+++ b/solutions/chain-of-responsibility/rules/instrument-warmup.ts
@@ -0,0 +1,11 @@
+import { BaseRule } from "../rule.ts";
+import type { ObservationRequest } from "../types.ts";
+
+export class InstrumentWarmupRule extends BaseRule {
+  protected check(request: ObservationRequest): string | null {
+    if (request.instrumentWarmupComplete === false) {
+      return "instrument has not completed its warmup sequence";
+    }
+    return null;
+  }
+}
