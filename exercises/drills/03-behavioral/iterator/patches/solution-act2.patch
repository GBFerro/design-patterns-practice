+
+/** The most recent entry whose message contains `needle`, or undefined if
+ *  none does - searched from the end, not the start. */
+export function mostRecentMatch(log: ObservationLog, needle: string): LogEntry | undefined {
+  for (const entry of log.reversed()) {
+    if (entry.message.includes(needle)) return entry;
+  }
+  return undefined;
+}
+
+/** The `count` most recent messages, most recent first, without walking the
+ *  log from the start. */
+export function recentMessages(log: ObservationLog, count: number): { messages: string[]; scanned: number } {
+  const messages: string[] = [];
+  let scanned = 0;
+  for (const entry of log.reversed()) {
+    scanned++;
+    messages.push(entry.message);
+    if (messages.length === count) break;
+  }
+  return { messages, scanned };
+}
+
+/** Up to `limit` entries whose message contains `needle`, in the order they
+ *  occurred, stopping as soon as `limit` is reached. */
+export function firstMatches(
+  log: ObservationLog,
+  needle: string,
+  limit: number,
+): { entries: LogEntry[]; scanned: number } {
+  const entries: LogEntry[] = [];
+  let scanned = 0;
+  for (const entry of log) {
+    scanned++;
+    if (entry.message.includes(needle)) {
+      entries.push(entry);
+      if (entries.length === limit) break;
+    }
+  }
+  return { entries, scanned };
+}
