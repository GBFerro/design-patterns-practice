+import type { SchedulingPolicy } from "../policy.ts";
+
+/** Highest targets first: less atmosphere in the way, better seeing. */
+export const darkestFirst: SchedulingPolicy = {
+  name: "darkest-first",
+  rank(candidates) {
+    return [...candidates].sort((a, b) => b.altitudeDeg - a.altitudeDeg);
+  },
+};
