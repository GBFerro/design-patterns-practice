diff --git a/src/records/dome.ts b/src/records/dome.ts
new file mode 100644
index 0000000..adde65d
--- /dev/null
+++ b/src/records/dome.ts
@@ -0,0 +1,29 @@
+import { LogRecord } from "../record.ts";
+
+/** The dome opening or closing. Costs no telescope time, is never an
+ *  anomaly on its own, and has no operator note of its own - the event
+ *  that closed the dome already produced one. */
+export class DomeRecord extends LogRecord {
+  constructor(
+    readonly domeState: "opened" | "closed",
+    readonly reason: string,
+  ) {
+    super();
+  }
+
+  toLine(): string {
+    return `dome ${this.domeState}: ${this.reason}`;
+  }
+
+  costSeconds(): number {
+    return 0;
+  }
+
+  isAnomaly(): boolean {
+    return false;
+  }
+
+  operatorNote(): string | null {
+    return null;
+  }
+}
