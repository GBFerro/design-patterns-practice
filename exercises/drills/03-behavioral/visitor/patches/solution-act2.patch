index 0000000..3cdaf5f
--- /dev/null
+++ b/solutions/visitor/records/dome.ts
@@ -0,0 +1,15 @@
+import { LogRecord } from "../record.ts";
+import type { LogRecordVisitor } from "../visitor.ts";
+
+export class DomeRecord extends LogRecord {
+  constructor(
+    readonly domeState: "opened" | "closed",
+    readonly reason: string,
+  ) {
+    super();
+  }
+
+  accept<R>(visitor: LogRecordVisitor<R>): R {
+    return visitor.visitDome(this);
+  }
+}
