diff --git a/after/solutions/visitor/reports/operator-note.ts b/solutions/visitor/reports/operator-note.ts
new file mode 100644
index 0000000..00eb64f
--- /dev/null
+++ b/solutions/visitor/reports/operator-note.ts
@@ -0,0 +1,23 @@
+import type { DomeRecord } from "../records/dome.ts";
+import type { ExposureRecord } from "../records/exposure.ts";
+import type { SeeingRecord } from "../records/seeing.ts";
+import type { WeatherRecord } from "../records/weather.ts";
+import type { LogRecordVisitor } from "../visitor.ts";
+
+export class OperatorNoteVisitor implements LogRecordVisitor<string | null> {
+  visitSeeing(_record: SeeingRecord): string | null {
+    return null;
+  }
+
+  visitWeather(record: WeatherRecord): string | null {
+    return record.severity >= 8 ? "consider closing the dome" : null;
+  }
+
+  visitExposure(record: ExposureRecord): string | null {
+    return record.seconds > 1800 ? "long exposure - verify guiding" : null;
+  }
+
+  visitDome(_record: DomeRecord): string | null {
+    return null;
+  }
+}
