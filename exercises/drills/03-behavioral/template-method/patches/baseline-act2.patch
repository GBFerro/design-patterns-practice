+function runGuideCameraNight(target: string): NightLog {
+  const steps: StepLog[] = [];
+
+  const port = "usb-gdc-4";
+  steps.push({ step: "connect", detail: port });
+
+  const frames = 60;
+  const exposureSeconds = 0.5;
+  steps.push({ step: "capture", detail: `${frames} frames @ ${exposureSeconds}s` });
+
+  const bytes = frames * 400_000;
+  steps.push({ step: "download", detail: `${bytes} bytes` });
+
+  steps.push({ step: "disconnect", detail: port });
+
+  return { instrument: "guide-camera", target, steps };
+}
