index 0000000..c0803d9
--- /dev/null
+++ b/solutions/template-method/instruments/guide-camera.ts
@@ -0,0 +1,21 @@
+import type { InstrumentHooks } from "../pipeline.ts";
+
+const PORT = "usb-gdc-4";
+
+/** An uncooled finder camera used only to hold lock between exposures. No
+ *  reference frame exists for it, so it does not calibrate at all. */
+export const guideCamera: InstrumentHooks = {
+  name: "guide-camera",
+  connect() {
+    return { port: PORT };
+  },
+  capture(_connection, _calibration, _target) {
+    return { frames: 60, exposureSeconds: 0.5 };
+  },
+  download(capture) {
+    return { bytes: capture.frames * 400_000 };
+  },
+  disconnect() {
+    // Nothing to park; the sensor just stops reading.
+  },
+};
